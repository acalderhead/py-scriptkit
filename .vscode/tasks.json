{
  "version": "2.0.0",
  "tasks": [
    {
      // Default test task → "Run Test Task". Runs the suite on the default
      // Python (3.13), using that version's editable-install venv.
      "label": "pytest (3.13)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv313/Scripts/python.exe",
      "args": ["-m", "pytest", "-q"],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "clear": true },
      "problemMatcher": []
    },
    {
      "label": "pytest (3.12)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv312/Scripts/python.exe",
      "args": ["-m", "pytest", "-q"],
      "group": "test",
      "presentation": { "clear": true },
      "problemMatcher": []
    },
    {
      "label": "pytest (3.11)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv311/Scripts/python.exe",
      "args": ["-m", "pytest", "-q"],
      "group": "test",
      "presentation": { "clear": true },
      "problemMatcher": []
    },
    {
      // Run the suite on all three versions in sequence (local mini-matrix).
      "label": "pytest (all versions)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv311/Scripts/python.exe -m pytest -q; ${workspaceFolder}/.venv312/Scripts/python.exe -m pytest -q; ${workspaceFolder}/.venv313/Scripts/python.exe -m pytest -q",
      "group": "test",
      "presentation": { "clear": true },
      "problemMatcher": []
    },
    {
      "label": "ruff check",
      "type": "shell",
      "command": "${workspaceFolder}/.venv313/Scripts/python.exe",
      "args": ["-m", "ruff", "check", "."],
      "problemMatcher": []
    }
  ]
}
